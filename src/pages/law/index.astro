---
import Base from '../../layouts/Base.astro';
import { SITE, absoluteUrl, longDate } from '../../lib/site';
import { breadcrumbs, scholarlyArticle } from '../../lib/schema';
import sources from '../../data/cbi/sources.json';

const PATH = '/law';
const pageUrl = absoluteUrl(PATH);
const title = 'The Instruments Governing Turkish Citizenship by Investment';
const description =
  'The legal framework, instrument by instrument: Law No. 5901 art. 12(1)(b), art. 20 of the implementing Regulation and its amending decisions, the VAT exemption in Law No. 3065, the fee tariffs in Law No. 492, and the residence permit ground in Law No. 6458. Each annotated, each with its Resmî Gazete reference.';

const PAGES = [
  {
    href: '/law/regulation-article-20',
    title: 'Article 20 of the implementing Regulation, annotated',
    blurb:
      'The central article. Seven sub-paragraphs, seven routes, with the threshold, the holding period and the certifying authority for each, plus what the article does not do.',
    tag: 'Regulation 2010/139 art. 20',
  },
  {
    href: '/law/currency-conversion',
    title: 'Article 20(10): why a qualifying deposit is held in Turkish lira',
    blurb:
      'The 2022 change that moved no threshold and so went largely unreported, but which transferred three years of lira exposure onto the investor.',
    tag: 'Presidential Decision No. 5072',
  },
  {
    href: '/law/threshold-history',
    title: 'Every threshold since 2017, with the instrument that set it',
    blurb:
      'The chronology, and why it is operational rather than historical: the figure that governs a file is the one in force on the date of the acquisition.',
    tag: 'BKK 2016/9601 to CBK 5554',
  },
  {
    href: '/law/vat-exemption',
    title: 'The foreign-buyer VAT exemption and its three-year condition',
    blurb:
      'Extended from one year to three in 2022, and still published as one year across much of the market. The one error on this subject with a directly calculable price.',
    tag: 'VAT Law art. 13(1)(i), Law No. 7394',
  },
];

/* The register, rendered so a reader can see the whole framework at once
   rather than meeting instruments one page at a time. */
const INSTRUMENTS = ((sources as any).sources ?? []).filter((s: any) =>
  ['statute', 'regulation', 'amending_instrument'].includes(s.kind),
);

const KIND_LABEL: Record<string, string> = {
  statute: 'Statute',
  regulation: 'Regulation',
  amending_instrument: 'Amending instrument',
};

const schema = [
  scholarlyArticle({ headline: title, description, url: pageUrl, datePublished: '2026-11-11' }),
  breadcrumbs([
    { name: 'Home', url: absoluteUrl('/') },
    { name: 'The law', url: pageUrl },
  ]),
];
---

<Base title={title} description={description} path={PATH} schema={schema}>
  <div class="mx-auto max-w-6xl px-(--spacing-gutter) py-14">
    <nav class="ui-label text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-cite">Home</a> / The law
    </nav>

    <header class="mt-5 max-w-3xl">
      <h1 class="text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
        The instruments
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">
        The programme rests on one clause of one statute and one article of one regulation. The
        clause creates a discretionary power and names no figure; the article carries every
        threshold, every holding period and the conversion requirement. Everything else is tax,
        fees, residence and legalisation.
      </p>
      <p class="mt-4 max-w-2xl leading-relaxed text-ink-soft">
        That division matters in practice. Because the figures sit in secondary legislation, they
        move by decision rather than by legislation, and a practitioner reading only the Law will
        not find a single number that governs a file.
      </p>
    </header>

    <section class="mt-12">
      <h2 class="ui-label text-ink-faint">Annotated</h2>
      <div class="mt-5 divide-y rule border-y rule">
        {PAGES.map((p) => (
          <article class="py-6">
            <p class="cite">{p.tag}</p>
            <h3 class="mt-1 text-lg font-semibold leading-snug">
              <a href={p.href} class="underline decoration-cite-soft hover:text-cite">{p.title}</a>
            </h3>
            <p class="mt-1.5 max-w-2xl leading-relaxed text-ink-soft">{p.blurb}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-14">
      <h2 class="ui-label text-ink-faint">The whole framework, as a register</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">
        Every statute, regulation and amending instrument this site relies on, with its Resmî
        Gazete date and issue and how far we got in confirming it. "Official text located" means
        we read the instrument. "Official reference located" means we read the consolidated text
        and found the reference but not the instrument as published, which is a weaker claim and
        is recorded as one.
      </p>
      <div class="scroll-x mt-6">
        <table class="ref-table">
          <thead>
            <tr><th>Instrument</th><th>No.</th><th>Resmî Gazete</th><th>Type</th><th>Used for</th></tr>
          </thead>
          <tbody>
            {INSTRUMENTS.map((s: any) => {
              const rg = s.resmiGazete ?? {};
              const arts = (s.articlesUsed ?? []).map((a: any) => a.article).join(', ');
              return (
                <tr>
                  <td>
                    {s.url ? (
                      <a href={s.url} rel="noopener" class="underline decoration-cite-soft">
                        {s.titleEn ?? s.titleTrNative ?? s.titleTr}
                      </a>
                    ) : (
                      s.titleEn ?? s.titleTrNative ?? s.titleTr
                    )}
                    {s.titleTrNative && s.titleEn && (
                      <span class="block text-[0.75rem] text-ink-faint">{s.titleTrNative}</span>
                    )}
                  </td>
                  <td class="whitespace-nowrap">{s.number ?? 'not recorded'}</td>
                  <td class="whitespace-nowrap">
                    {rg.date ? longDate(rg.date) : 'not recorded'}
                    {rg.issue && <span class="block text-[0.75rem] text-ink-faint">No. {rg.issue}</span>}
                  </td>
                  <td class="whitespace-nowrap">{KIND_LABEL[s.kind] ?? s.kind}</td>
                  <td>{arts ? `arts. ${arts}` : (s.effect ?? '').slice(0, 90)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="font-ui mt-4 text-[0.8125rem] text-ink-faint">
        The register is published as data:
        {' '}<a href="/data" class="underline decoration-cite-soft">sources.json</a>, CC BY 4.0,
        with the verification status and last-checked date for every entry.
      </p>
    </section>

    <section class="mt-14 max-w-2xl">
      <h2 class="ui-label text-ink-faint">Not yet written</h2>
      <p class="mt-3 leading-relaxed text-ink-soft">
        Pages on the residence permit ground in Law No. 6458 art. 31(1)(j), the fee tariffs under
        Law No. 492, the annulment and withdrawal powers in arts. 31 and 40 of Law No. 5901, and
        the legalisation framework under the 1961 Hague Convention are in preparation. The
        instruments are already in the register above, and the apostille status table is already
        published as <a href="/data" class="underline decoration-cite-soft">data</a>.
      </p>
      <p class="mt-3 leading-relaxed text-ink-soft">
        If you practise in this area and something here is wrong, or an instrument is missing,
        <a href={`mailto:${SITE.email}`} class="underline decoration-cite-soft"> write to the editor</a>.
        Corrections are published with the date they were made.
      </p>
    </section>
  </div>
</Base>
