---
import Base from '../layouts/Base.astro';
import { SITE, absoluteUrl, longDate, usd } from '../lib/site';
import { breadcrumbs, scholarlyArticle } from '../lib/schema';
import thresholds from '../data/cbi/investment-thresholds.json';
import processing from '../data/cbi/processing-times.json';
import sources from '../data/cbi/sources.json';
import apostille from '../data/cbi/apostille-countries.json';

const PATH = '/';
const pageUrl = absoluteUrl(PATH);
const title = 'Turkish Citizenship by Investment: An Annotated Reference';
const description =
  'An independent reference on Turkish citizenship by investment: the governing instruments annotated article by article, the procedure, the published figures with their sources, and what no authority publishes. Free, CC BY 4.0, with no paid placement of any kind.';

const asOf: string = (thresholds as any).asOf ?? '';
const current: any[] = (thresholds as any).current ?? [];
const openQuestions: string[] = (sources as any).openQuestions ?? [];
const sourceCount = ((sources as any).sources ?? []).length;

const schema = [
  scholarlyArticle({
    headline: title,
    description,
    url: pageUrl,
    datePublished: '2026-11-11',
  }),
  breadcrumbs([{ name: 'Home', url: pageUrl }]),
];

/*
 * The errata. These are the four claims the rest of the market gets wrong most
 * often, and they are the reason this site exists, so they are set as findings
 * rather than buried in a list.
 */
const ERRATA = [
  {
    claim: 'The deposit is held in lira, not dollars',
    body:
      'Since 6 January 2022, art. 20(10) requires the foreign currency to be sold to the bank and by the bank to the Central Bank. The investor carries lira exposure for three years. Sources calling it an FX deposit describe the pre-2022 position.',
    href: '/law/currency-conversion',
    link: 'Article 20(10)',
  },
  {
    claim: 'The VAT condition is three years, not one',
    body:
      'Law No. 7394 replaced "one year" with "three years" in VAT Law art. 13(1)(i), in force 1 May 2022. Much of the market still publishes one year. A buyer who sells in year two on that advice repays the exempted VAT with interest.',
    href: '/law/vat-exemption',
    link: 'The exemption',
  },
  {
    claim: 'No authority publishes a processing time',
    body: `Neither the Law nor the Regulation sets a deadline, and no ministry publishes an end-to-end figure. Every duration in circulation, including the ${processing.endToEnd.lowMonths} to ${processing.endToEnd.highMonths} months recorded here, is an observation and is marked as one in the data.`,
    href: '/data#processing-times',
    link: 'What is recorded, and how',
  },
  {
    claim: 'The threshold is the appraisal, not the price',
    body: `Four figures must each independently reach ${usd(400000)}: the appraised value, the declared deed value, the currency-purchase certificate and the sum transferred to the seller. Fees and VAT count toward none of them.`,
    href: '/law/regulation-article-20#art-20-2-b',
    link: 'Article 20(2)(b)',
  },
];

const SECTIONS = [
  {
    href: '/law',
    label: 'The law',
    blurb:
      'The instruments, annotated. Law No. 5901 art. 12(1)(b) creates the power; art. 20 of the implementing Regulation carries every figure. Each page states the condition, names the certifying authority and separates the text from the gloss.',
  },
  {
    href: '/procedure',
    label: 'Procedure',
    blurb:
      'The chain from investment to decision: appraisal, certificate of conformity, residence permit under Law No. 6458 art. 31(1)(j), the citizenship file, the decision. What each stage produces and what it is tested against.',
  },
  {
    href: '/data',
    label: 'Data',
    blurb: `Machine-readable, CC BY 4.0: thresholds and their statutory basis, government costs, document requirements, the Hague Apostille status table, observed processing times, dollar-return series, and a register of ${sourceCount} primary sources.`,
  },
  {
    href: '/tools',
    label: 'Tools',
    blurb:
      'Calculators that compute from the dataset rather than from assertions: what a purchase costs beyond the investment, which documents an issuing country needs, where a pending file sits against observed durations.',
  },
  {
    href: '/directory',
    label: 'Practitioners',
    blurb:
      'A register of firms doing this work, with how each was verified and what each discloses. Nothing in it can be bought.',
  },
  {
    href: '/method',
    label: 'Method',
    blurb:
      'How a figure gets onto this site, how a firm gets into the register, what we do when sources disagree, and what we refuse to publish.',
  },
];
---

<Base title={title} description={description} path={PATH} schema={schema} rawTitle>
  <div class="shell">
    <section class="page-head border-b rule py-14 sm:py-20">
      <h1>
        Turkish citizenship by investment, as the instruments actually set it out
      </h1>
      <div class="mt-9 grid gap-x-14 gap-y-8 border-t border-line-strong pt-7 lg:grid-cols-2">
        <p class="deck !mt-0">
          Most of what is published about this programme is written to sell a service, and it
          shows: thresholds without the decision that set them, processing times presented as
          commitments, a VAT condition that changed in 2022 and is still quoted at its old length,
          and a deposit route still described as a way to hold foreign currency four years after
          that stopped being true.
        </p>
        <p class="finding !my-0">
          This is a reference work instead. Every figure names the instrument behind it and the
          date. Where the sources disagree, it says so. Where no authority publishes a number, it
          says that too, rather than supplying one.
        </p>
      </div>
      <p class="page-meta !max-w-none">
        Current as of {longDate(asOf)} &middot; {sourceCount} primary sources in the register
        &middot; text and data under
        {' '}<a href={SITE.license.url} rel="license noopener">CC BY 4.0</a>
      </p>
    </section>

    <section class="border-b rule py-12 sm:py-16">
      <p class="eyebrow">The programme in one table</p>
      <h2 class="section-head mt-2">Thresholds under article 20(2)</h2>
      <p class="mt-3 max-w-[36rem] text-ink-soft">
        The sub-paragraph letter is the instrument's own, and it is what a certificate of
        conformity cites.
      </p>
      <div class="scroll-x mt-7">
        <table class="ref-table">
          <thead>
            <tr><th>Route</th><th>Minimum</th><th>Holding</th><th>Condition</th><th>Effective</th></tr>
          </thead>
          <tbody>
            {current.map((r: any) => (
              <tr>
                <td class="whitespace-nowrap font-semibold">{r.label}</td>
                <td class="whitespace-nowrap">
                  {r.minimum != null ? usd(r.minimum) : r.employees != null ? `${r.employees} employees` : 'not recorded'}
                </td>
                <td class="whitespace-nowrap">
                  {r.holdingPeriodYears == null ? 'none stated' : `${r.holdingPeriodYears} years`}
                </td>
                <td>{r.basis}</td>
                <td class="whitespace-nowrap">{r.effectiveFrom ? longDate(r.effectiveFrom) : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="font-ui mt-5 text-[0.8125rem] text-ink-faint">
        <a href="/law/regulation-article-20" class="linked">Each sub-paragraph annotated</a>
        {' '}&middot;
        <a href="/law/threshold-history" class="linked">every change since 2017</a>
      </p>
    </section>

    <section class="border-b rule py-12 sm:py-16">
      <p class="eyebrow">Errata</p>
      <h2 class="section-head mt-2">Four things commonly got wrong</h2>
      <div class="mt-9 grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {ERRATA.map((e, i) => (
          <div class="numbered">
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-[1.1875rem] font-semibold leading-snug">{e.claim}</h3>
            <p class="mt-2 text-[1rem] leading-relaxed text-ink-soft">{e.body}</p>
            <p class="font-ui mt-3 text-[0.75rem]">
              <a href={e.href} class="linked">{e.link}</a>
            </p>
          </div>
        ))}
      </div>
    </section>

    <section class="border-b rule py-12 sm:py-16">
      <p class="eyebrow">Contents</p>
      <h2 class="section-head mt-2">The six sections of this work</h2>
      <div class="mt-9 grid gap-x-12 gap-y-9 sm:grid-cols-2 lg:grid-cols-3">
        {SECTIONS.map((s, i) => (
          <div class="border-t border-line-strong pt-3.5">
            <p class="font-mono-ref text-[0.625rem] tracking-[0.14em] text-cite">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-1.5 text-[1.1875rem] font-semibold leading-snug">
              <a href={s.href} class="linked">{s.label}</a>
            </h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-soft">{s.blurb}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="py-12 sm:py-16">
      <p class="eyebrow">The register of gaps</p>
      <h2 class="section-head mt-2">What we do not know</h2>
      <div class="mt-5 grid gap-x-12 gap-y-7 lg:grid-cols-[minmax(0,24rem)_1fr]">
        <p class="text-ink-soft">
          {openQuestions.length} questions are open in the source register, published as questions.
          A reference work that resolves everything is either lucky or lying, and the gaps are the
          part practitioners quote back to us most often.
        </p>
        <ul class="space-y-3">
          {openQuestions.slice(0, 4).map((q) => (
            <li class="unknown">{q}</li>
          ))}
        </ul>
      </div>
      <p class="font-ui mt-7 max-w-[36rem] text-[0.75rem] leading-relaxed text-ink-faint">
        <a href="/data#open-questions" class="linked">All of them</a>
        {' '}&middot; the Hague Apostille table covers {apostille.counts.parties} Contracting
        Parties, and says plainly that absence from it is not an answer
      </p>
    </section>
  </div>
</Base>
