---
import Base from '../../layouts/Base.astro';
import { SITE, absoluteUrl, longDate } from '../../lib/site';
import { breadcrumbs, scholarlyArticle } from '../../lib/schema';
import thresholds from '../../data/cbi/investment-thresholds.json';

const PATH = '/tools';
const pageUrl = absoluteUrl(PATH);
const title = 'Calculators, Computed From the Published Data';
const description =
  'Calculators for Turkish citizenship by investment that compute from the published dataset rather than from assertions: transaction costs beyond the investment, document legalisation by issuing country, and where a pending file sits against observed durations.';

const asOf: string = (thresholds as any).asOf ?? '';

const LIVE = [
  {
    href: '/tools/cost-calculator',
    title: 'Costs beyond the investment',
    blurb:
      'Title deed transfer tax, VAT where it is due, the SPK appraisal, the conversion spread and the per-person fees, by family size. Every line computed from the published cost data with the condition attached.',
  },
] as const;

const PLANNED = [
  ['Document legalisation by issuing country', 'Answers apostille or consular legalisation from the full Hague status table, including the case a yes-or-no field gets wrong: a state that has acceded but for which the Convention is not yet in force.'],
  ['Where a pending file sits', 'Compares a wait against the durations observed per stage, with the thresholds at which a formal status query becomes reasonable. Marked as observation throughout, because no authority publishes a processing time.'],
  ['Route comparison', 'The seven sub-paragraphs of art. 20(2) set against what an investor is actually optimising for: keeping a usable asset, total cost, fewest steps, or a clean verification trail.'],
] as const;

const schema = [
  scholarlyArticle({ headline: title, description, url: pageUrl, datePublished: '2026-11-11' }),
  breadcrumbs([
    { name: 'Home', url: absoluteUrl('/') },
    { name: 'Tools', url: pageUrl },
  ]),
];
---

<Base title={title} description={description} path={PATH} schema={schema}>
  <div class="mx-auto max-w-6xl px-(--spacing-gutter) py-14">
    <nav class="ui-label text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-cite">Home</a> / Tools
    </nav>

    <header class="mt-5 max-w-3xl">
      <h1 class="text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">Calculators</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">
        Each of these reads
        {' '}<a href="/data" class="underline decoration-cite-soft">the published dataset</a> at
        build time rather than carrying its own copy of the figures. That is the whole design
        principle: a calculator that holds its own numbers will eventually disagree with the page
        that explains them, and the reader has no way to tell which one is stale.
      </p>
      <p class="font-ui mt-4 text-[0.8125rem] text-ink-faint">
        Data as of {longDate(asOf)}. No sign-up, no tracking, and nothing recorded about what you
        enter: these run entirely in your browser.
      </p>
    </header>

    <section class="mt-12">
      <h2 class="ui-label text-ink-faint">Published</h2>
      <div class="mt-5 divide-y rule border-y rule">
        {LIVE.map((t) => (
          <article class="py-6">
            <h3 class="text-lg font-semibold leading-snug">
              <a href={t.href} class="underline decoration-cite-soft hover:text-cite">{t.title}</a>
            </h3>
            <p class="mt-1.5 max-w-2xl leading-relaxed text-ink-soft">{t.blurb}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-12 max-w-2xl">
      <h2 class="ui-label text-ink-faint">In preparation</h2>
      <p class="mt-3 leading-relaxed text-ink-soft">
        Listed because the data behind them is already published, so anyone can build these
        before we do.
      </p>
      <dl class="mt-5 space-y-5">
        {PLANNED.map(([name, blurb]) => (
          <div>
            <dt class="font-ui text-[0.9375rem] font-semibold">{name}</dt>
            <dd class="mt-1 leading-relaxed text-ink-soft">{blurb}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-12 max-w-2xl">
      <h2 class="ui-label text-ink-faint">Reuse</h2>
      <p class="mt-3 leading-relaxed text-ink-soft">
        The data is CC BY 4.0 and the calculations are not secret. If you want to build one of
        these into your own site, take
        {' '}<a href="/data#files" class="underline decoration-cite-soft">the files</a> and do it.
        An attribution is all that is asked, and a link back is not a condition.
      </p>
      <p class="mt-3 leading-relaxed text-ink-soft">
        If something computes wrongly,
        <a href={`mailto:${SITE.email}`} class="underline decoration-cite-soft"> tell the editor</a>:
        a calculation error here is a data error or a code error, and both get fixed in public.
      </p>
    </section>
  </div>
</Base>
